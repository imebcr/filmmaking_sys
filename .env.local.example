NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
NEXT_PUBLIC_APP_URL=http://localhost:3000
RESEND_API_KEY=your-resend-api-key-here
RESEND_FROM_EMAIL=Zidny <noreply@zidny.local>

# NextAuth (member/team-member login sessions)
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000

# Telegram bot (create via @BotFather, set webhook to /api/telegram/webhook)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here

# Admin gets notified directly (admin has no `editors` row — Supabase Auth only)
ADMIN_NOTIFICATION_EMAIL=admin@zidny.local
ADMIN_TELEGRAM_CHAT_ID=

# Deliverables storage — local disk fallback for the VPS mount described in
# CDC §7.2 (/var/zidny/deliverables). Point this at the real mount in production.
DELIVERABLES_ROOT=./storage/deliverables

# Optional: secret required to call /api/cron/* routes (Vercel Cron or external scheduler)
CRON_SECRET=change-me
